 {
  "name": "trace",
  "session": "admin",
  "path": "/lots",
  "wait": 6000,
  "steps": [
   {
    "shot": "lots.jpg"
   },
   {
    "run": "document.head.insertAdjacentHTML('beforeend', '<style>.topbar{backdrop-filter:none !important}</style>')"
   },
   {
    "key": "Control+k",
    "wait": 700
   },
   {
    "type": "LR-261113-0005",
    "frames": "palette",
    "delay": 420,
    "settle": 900
   },
   {
    "measure": {
     "resultat": ".palette-result",
     "champ": ".palette-input"
    },
    "as": "palette"
   },
   {
    "key": "Escape",
    "wait": 500
   },
   {
    "click": "input[type=search], main input",
    "wait": 300
   },
   {
    "type": "LR-261113-0005",
    "wait": 2500,
    "shot": "lots-filtre.jpg"
   },
   {
    "measure": {
     "ligne": ".lot-number"
    }
   },
   {
    "click": ".lot-number",
    "wait": 1500,
    "shot": "tiroir-detail.jpg"
   },
   {
    "measure": {
     "tiroir": ".drawer",
     "onglet": ".drawer-tab:nth-child(2)",
     "rappel": ".drawer-footer .danger"
    }
   },
   {
    "click": ".drawer-tab:nth-child(2)",
    "wait": 3500,
    "shot": "tiroir-trace.jpg"
   },
   {
    "measure": {
     "corps": ".drawer-body",
     "arbre": ".drawer-body .trace-tree"
    }
   },
   {
    "run": "document.querySelector('.drawer-body').scrollTo(0, 420)",
    "wait": 700,
    "shot": "tiroir-trace-2.jpg"
   },
   {
    "run": "document.querySelector('.drawer-body').scrollTo(0, 900)",
    "wait": 700,
    "shot": "tiroir-trace-3.jpg"
   },
   {
    "run": "window.__h = document.querySelector('.drawer-body').scrollHeight; document.querySelector('.drawer-body').scrollTo(0, 0)",
    "wait": 400
   },
   {
    "hover": ".drawer-footer .danger",
    "wait": 500,
    "shot": "tiroir-survol.jpg"
   },
   {
    "click": ".drawer-footer .danger",
    "wait": 5000,
    "shot": "simulation.jpg",
    "tall": true
   }
  ]
 },
