# Copie ce fichier en .env puis adapte les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).

# --- Base de données PostgreSQL ---
POSTGRES_DB=erp_agro
POSTGRES_USER=erp_agro
POSTGRES_PASSWORD=change-moi
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port ouvert sur ton PC (pour Power BI / Excel). Change-le si 5432 est déjà pris.
POSTGRES_HOST_PORT=5432

# --- Power BI / Excel (utilisateur PostgreSQL en lecture seule, schéma bi) ---
# Créé par : docker compose exec backend python manage.py creer_utilisateur_bi
BI_DB_USER=powerbi
# Au moins 12 caractères (voir README pour en générer un)
BI_DB_PASSWORD=change-moi-aussi

# --- Django ---
# Clé secrète : mets une longue chaîne aléatoire (voir README).
DJANGO_SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Adresse du front-end, autorisée à envoyer des formulaires (connexion…)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0

# --- Front-end ---
# Adresse du back-end vue depuis le conteneur front-end.
API_PROXY_TARGET=http://backend:8000
# Nécessaire sous Windows pour que la page se recharge quand on modifie le code.
VITE_USE_POLLING=true
